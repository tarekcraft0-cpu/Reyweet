# ——— واجهة Vite (العميل) ———
# شغّل مرة واحدة بعد تغيير الشبكة: npm run sync:api
# الخادم المحلي على القرص D (مجلد backend/) — HOST=0.0.0.0
# تطوير محلي فقط — لا يُستخدم في Codemagic (هناك CAPACITOR_NATIVE=1 → https://reyweet.vercel.app)
VITE_API_URL=http://localhost:3000
VITE_API_URL_MOBILE=http://localhost:3000
# إنتاج iOS (يُضبط تلقائياً في scripts/prepare-capacitor-ios.mjs):
# RETWEET_PUBLIC_API_URL=https://reyweet.vercel.app

# ——— Firebase Cloud Messaging (إشعارات الدفع — الويب) ———
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
# (اختياري) VITE_FIREBASE_AUTH_DOMAIN= VITE_FIREBASE_STORAGE_BUCKET=
