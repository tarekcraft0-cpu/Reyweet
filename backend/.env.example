# مسار التخزين على القرص D (قاعدة البيانات + الميديا المضغوطة)
DATA_ROOT=D:/RetweetSocial

PORT=3000
HOST=0.0.0.0

JWT_SECRET=change_me_to_a_long_random_string_32chars
BCRYPT_ROUNDS=12

# عنوان API العام — روابط الريلز: {PUBLIC_BASE_URL}/uploads/reels/*.mp4
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# ملفات الريلز على القرص: {DATA_ROOT}/uploads/reels/ و .../thumbnails/
# CORS_ORIGINS=https://reyweet.vercel.app

# ——— Gmail / OTP (إلزامي للتسجيل واستعادة كلمة المرور) ———
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
# أو نفس القيم بأسماء بديلة:
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Retweet <your@gmail.com>"

# لا تُظهر الرموز في استجابة API أو الواجهة (اتركه معطّلاً في الإنتاج)
# OTP_DEBUG=1

# حسابات أسماء قصيرة (اختياري — تُعرَّف أيضاً في shortUsernameAccounts.ts)
# SHORT_USERNAME_1_USER_ID=863b808b-0c26-4d9f-b1c5-b9b586e31d44
# SHORT_USERNAME_M_USER_ID=beb31b7a-1aa8-4268-b299-35aaf1d0de5f

# حماية صارمة ضد البوتات (افتراضي: مفعّل — عطّله فقط للتطوير المحلي)
# AUTH_STRICT_MODE=1
# LOGIN_OTP_REQUIRED=1
# تشفير لقطات المستخدمين على القرص (32+ حرف عشوائي)
# DATA_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
# Cloudflare Turnstile (اختياري — أقوى حماية)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# PUBLIC_APP_URL=https://reyweet.vercel.app
# استعادة كلمة المرور برابط بريد (افتراضي عند تفعيل SMTP)
# PASSWORD_RESET_USES_LINK=1

# ——— اشتراك التوثيق (Stripe — بطاقة + Apple Pay) ———
# من لوحة Stripe: Developers → API keys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# معرّف سعر اشتراك شهري (Products → Price) — اختياري لصفحة Checkout البديلة
# STRIPE_VERIFIED_PRICE_ID=price_...

# ——— إشعارات iPhone مباشرة من VPS → Apple (بدون Firebase) ———
# من Apple Developer → Keys → Apple Push Notifications (.p8)
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.reyweet.app
# APNS_KEY_PATH=D:/secrets/AuthKey_XXXXXXXXXX.p8
# أو المحتوى كاملاً:
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_PRODUCTION=0
# تخزين توكنات الأجهزة على القرص (افتراضي): {DATA_ROOT}/push_tokens.json
# PUSH_TOKEN_STORE=file
# APNS_NOTIFICATION_SOUND=default

# ——— نسخ احتياطي يومي (VPS) ———
# مجلد الأرشيف: {DATA_ROOT}/backups/retweet-YYYY-MM-DDTHH-MM-SS.tar.gz
# RETWEET_BACKUP_DIR=/var/lib/retweet/backups
# RETWEET_BACKUP_KEEP_DAYS=14
# RETWEET_BACKUP_INCLUDE_MEDIA=1
# تثبيت cron: npm run contabo:backup-cron

# ——— مكالمات WebRTC (TURN على نفس VPS — يُضبط تلقائياً عند contabo:deploy) ———
# TURN_URL=turn:109.199.111.29:3478?transport=udp
# TURN_URLS=turn:109.199.111.29:3478?transport=udp,turn:109.199.111.29:3478?transport=tcp
# TURN_USERNAME=reyweet
# TURN_CREDENTIAL=

# ——— Android FCM (اختياري — إن وُجد تطبيق أندرويد) ———
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# أو FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
